*@
@{
}
@model List<Agri_Connect.Models.Entities.Product>
@using Agri_Connect.Enums
@using System.ComponentModel.DataAnnotations

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Jumbotron Section -->
<div class="jumbotron jumbotron-fluid text-center bg-light p-4 mb-4">
    <div class="container">
        <h1 class="display-4">
            @if (User.IsInRole("Employee"))
            {
                // If the user is an admin
                @:All Products
            }
            else if (User.IsInRole("Farmer"))
            {
                // If the user is a farmer
                @:My Products
            }
        </h1>
        <p class="lead">Review all the products added</p>
    </div>
</div>

<!-- Filter & Search Form -->
<div class="container mb-4">
    <form method="get">
        <div class="row">
            <!-- Search by name -->
            <div class="col-md-4">
                <input type="text" name="searchQuery" class="form-control" placeholder="Search by name"
                       value="@Context.Request.Query["searchQuery"]">
            </div>
            <!-- Filter by Type -->
            <div class="col-md-4">
                <select name="type" class="form-control">
                    <option value="">Filter by Product Type</option>
                    @foreach (var type in Enum.GetValues(typeof(ProductType)))
                    {
                        <option value="@type">@type.ToString()</option>
                    }
                </select>
            </div>
            <!-- Filter by Farmer (only for employees) -->
            @if (User.IsInRole("Employee"))
            {
                <div class="col-md-4">
                <select name="farmerId" class="form-control">
                    <option value="">Filter by Farmer</option>
                    @foreach (var farmer in ViewBag.Farmers ?? new List<SelectListItem>())
                    {
                        <option value="@farmer.Value">
                            @farmer.Text
                        </option>
                    }
                </select>
            </div>
            }
        </div>
        <div class="col-md-4 mt-2">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a href="/Products/List" class="btn btn-secondary">Clear Filters</a>
        </div>
    </form>    
</div>

<!-- Product Cards -->
<div class="container">
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4 d-flex align-items-stretch">
                <div class="card" style="height: 100%; width: 100%;">
                    <img class="card-img-top" 
                    src="@product.ProductImageUrl" 
                    alt="@product.ProductName" 
                    style="height:300px ;width:100%; object-fit: cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@product.ProductName</h5>
                        <p class="card-text">
                            <strong>Type:</strong> @product.Type<br />
                            <strong>Price:</strong> R @product.Price<br />
                            <strong>Quantity:</strong> @product.Quantity<br />
                            <strong>Description:</strong> @product.Description
                        </p>
                    </div>

                    <div class="card-footer">
                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning">Edit</a>
                        <form asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>