@model List<Agri_Connect.Models.Entities.Farmer>
<h2>All Farmers</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Farm Name</th>
            <th>Location</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var farmer in Model)
        {
            <tr>
                <td>@farmer.FullName</td>
                <td>@farmer.FarmName</td>
                <td>@farmer.Location</td>
            </tr>
        }
    </tbody>
</table>